# Copy this file to .env.local and fill in real values before production use.
# Every form on the site fails clearly if these are missing.
# see lib/env.ts and features/contact/actions.ts.

# Resend (contact email + newsletter confirmations)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form submissions
CONTACT_NOTIFICATION_EMAIL=
# Resend Audience ID that newsletter signups are added to
RESEND_AUDIENCE_ID=
# From address for newsletter confirmation emails (must be a verified Resend
# domain). Falls back to notifications@techspirex.com if unset.
NEWSLETTER_FROM_EMAIL=
# Secret used to sign stateless double-opt-in confirmation links (min 16 chars).
# Generate with: openssl rand -base64 32
NEWSLETTER_CONFIRM_SECRET=

# Cloudflare Turnstile (spam protection on contact + newsletter forms)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 (loads only after cookie consent - see ConsentBanner)
# Find your measurement ID in GA4 Admin > Data Streams
NEXT_PUBLIC_GA4_ID=

# Canonical site origin for absolute links in emails/metadata (optional;
# defaults to https://techspirex.com)
NEXT_PUBLIC_SITE_URL=

# Search engine ownership verification (rendered as <meta> tags; each ships only
# when set - see app/layout.tsx). Leave blank until the properties exist.
# Google Search Console > Settings > Ownership verification > HTML tag (content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Site verification > Meta tag (msvalidate.01 content value)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key for instant Bing/Yandex/Seznam/Naver submission. A working default
# is committed (public/<key>.txt); only set this to rotate to your own key, and
# rename the public key file to match. Run: npm run seo:indexnow
INDEXNOW_KEY=

# Set to "true" ONLY if a reverse proxy that overwrites x-forwarded-for and
# x-real-ip sits in front of the app. Those headers are client-forgeable, so
# without a trusted proxy the rate limiter refuses to treat them as a client
# identity and falls back to a coarse shared budget. Vercel is auto-detected
# (VERCEL=1) and does not need this. Any value other than "true" fails closed.
TRUST_PROXY_HEADERS=

# Shared rate-limit store (optional, but recommended before real traffic).
# Without these, lib/rate-limit.ts uses an in-memory limiter that is per-instance
# and resets on every cold start - so on serverless the 5-per-10-minutes budget
# is only ever best-effort. Set BOTH and the limit becomes global across every
# instance. Create a free Redis database at https://console.upstash.com, then
# copy its REST URL and REST token here. No SDK is required; the limiter calls
# the REST API directly, and falls back to in-memory if Redis is unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

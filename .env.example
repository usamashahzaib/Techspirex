# Copy this file to .env.local and fill in real values before production use.
# Every form on the site fails loudly (not silently) if these are missing —
# see lib/env.ts and features/contact/actions.ts.

# Resend (transactional email — contact form + newsletter confirmations)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form submissions
CONTACT_NOTIFICATION_EMAIL=
# Resend Audience ID that newsletter signups are added to
RESEND_AUDIENCE_ID=
# From address for newsletter confirmation emails (must be a verified Resend
# domain). Falls back to notifications@techspirex.com if unset.
NEWSLETTER_FROM_EMAIL=
# Secret used to sign stateless double-opt-in confirmation links (min 16 chars).
# Generate with: openssl rand -base64 32
NEWSLETTER_CONFIRM_SECRET=

# Cloudflare Turnstile (spam protection on contact + newsletter forms)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 (loads only after cookie consent — see ConsentBanner)
# Find your measurement ID in GA4 Admin > Data Streams
NEXT_PUBLIC_GA4_ID=

# Canonical site origin for absolute links in emails/metadata (optional;
# defaults to https://techspirex.com)
NEXT_PUBLIC_SITE_URL=
